# Schwab API Credentials
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_APP_SECRET=your_schwab_app_secret
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=./config/schwab_token.json
SCHWAB_ACCOUNT_HASH=your_account_hash

# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# Crypto Payout
CRYPTO_EXCHANGE=binance
CRYPTO_EXCHANGE_API_KEY=your_exchange_api_key
CRYPTO_EXCHANGE_SECRET=your_exchange_secret
PAYOUT_COIN=BTC
PAYOUT_WALLET_ADDRESS=your_wallet_address
PAYOUT_PERCENTAGE=0.05

# Risk Management
MAX_POSITION_SIZE_PCT=0.05
MAX_TOTAL_EXPOSURE_PCT=0.25
MAX_SINGLE_LOSS_PCT=0.02
DAILY_LOSS_LIMIT_PCT=0.05

# Arena Settings
TRADING_CYCLE_DAYS=15
PAPER_TRADE=true

# Data Sources
NEWS_API_KEY=your_news_api_key
POLYGON_API_KEY=your_polygon_api_key
